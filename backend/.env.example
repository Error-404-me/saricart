# App
APP_NAME=SariCart API
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./saricart.db

# JWT
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:5173


# Email (SMTP) — leave blank in dev to log emails instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@saricart.app
SMTP_USE_TLS=true

# Compliance
ACCOUNT_DELETION_RETENTION_DAYS=30