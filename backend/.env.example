# backend/.env.example
# App
APP_NAME=SariCart API
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./saricart.db

# JWT
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:5173

# Email: Resend tried first, Brevo as HTTP-API fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=SariCart <no-reply@yourdomain.com>

BREVO_API_KEY=

# Compliance
ACCOUNT_DELETION_RETENTION_DAYS=30