# App
APP_NAME=SariCart API
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./saricart.db

# JWT
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:5173


RESEND_API_KEY=
RESEND_FROM_EMAIL=SariCart <no-reply@yourdomain.com>

# SMTP fallback (only used if RESEND_API_KEY is blank, or as backup if Resend fails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=5

# Compliance
ACCOUNT_DELETION_RETENTION_DAYS=30